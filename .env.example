# ═══════════════════════════════════════════════════════════════════
# CAN-CAT — Configuración de Docker
# Copia este archivo a `.env` y edita los valores necesarios
# ═══════════════════════════════════════════════════════════════════

# ─── Base de datos ───
DB_NAME=can-cat-system
DB_USERNAME=can_cat_user
DB_PASSWORD=cambia_esta_password_segura
DB_PORT_EXPOSED=5432

# ─── Backend ───
BACKEND_PORT_EXPOSED=8080
SPRING_PROFILES_ACTIVE=dev

# Clave JWT: mínimo 64 caracteres aleatorios
# Genera una con: openssl rand -base64 64 | tr -d '\n' si estas en windows probablemente tengas que usar otra cosa
JWT_SECRET=CAMBIA_ESTO_por_una_clave_larga_y_aleatoria_de_al_menos_64_caracteres_abcdefghijklmnopqrstuvwxyz
JWT_EXPIRATION_MS=86400000

# ─── Correo (Gmail) ───
# Usa una "App Password", NO tu contraseña normal de Gmail
# Generar en: https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu-correo@gmail.com                 
MAIL_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Frontend ───
FRONTEND_PORT_EXPOSED=80
# URL pública que verá el usuario (usada en links de correo)
APP_FRONTEND_URL=http://localhost